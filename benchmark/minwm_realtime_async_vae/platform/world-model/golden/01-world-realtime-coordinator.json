{
  "affinity": {},
  "annotations": {
    "logs.loopit.me/bucket": "world-model",
    "logs.loopit.me/enabled": "true"
  },
  "appGroup": "world-studio",
  "appName": "World Realtime Coordinator",
  "args": [
    "exec python -m sglang.multimodal_gen.runtime.entrypoints.realtime_coordinator_server --host=0.0.0.0 --port=18081 --backend=dynamodb --table-name=${COORDINATOR_TABLE} --region=${AWS_REGION} --ttl-s=30 --worker-ttl-s=15 --wait-timeout-s=10 --candidate-limit=64 --denoiser-capacity-limit=4 --vae-capacity-limit=16"
  ],
  "businessLineId": "world-model",
  "clusterName": "world-model",
  "command": [
    "/bin/sh",
    "-ec"
  ],
  "deployType": "deployment",
  "env": [
    {
      "name": "COORDINATOR_TABLE",
      "value": "world-model-realtime"
    },
    {
      "name": "AWS_REGION",
      "value": "us-east-2"
    },
    {
      "name": "OTEL_SERVICE_NAME",
      "value": "world-realtime-coordinator"
    },
    {
      "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
      "value": "http://adot-collector.monitoring:4317"
    },
    {
      "name": "OTEL_RESOURCE_ATTRIBUTES",
      "value": "service.namespace=world-model,deployment.environment=production"
    }
  ],
  "image": "${WORLD_REALTIME_COORDINATOR_IMAGE_DIGEST}",
  "imagePullPolicy": "IfNotPresent",
  "initContainers": [],
  "kind": "application",
  "labels": {
    "app.kubernetes.io/part-of": "world-studio",
    "loopit.me/business-line": "world-model",
    "loopit.me/lane": "default",
    "loopit.me/managed-by": "platform",
    "loopit.me/service-id": "world-realtime-coordinator"
  },
  "lane": "default",
  "livenessProbe": {
    "failureThreshold": 6,
    "path": "/healthz",
    "periodSeconds": 15,
    "port": 18081,
    "timeoutSeconds": 5,
    "type": "httpGet"
  },
  "name": "world-realtime-coordinator",
  "namespace": "world-model",
  "networkPolicy": {
    "defaultDeny": true,
    "egressToServiceIds": [],
    "enabled": true,
    "externalEgress": [
      "dynamodb.us-east-2.amazonaws.com",
      "adot-collector.monitoring"
    ],
    "ingressFromServiceIds": [
      "world-realtime-gateway",
      "minwm-denoiser",
      "lingbot2-denoiser",
      "minwm-vae",
      "lingbot2-vae"
    ]
  },
  "nodeSelector": {},
  "podDisruptionBudget": {
    "minAvailable": 1
  },
  "readinessProbe": {
    "failureThreshold": 6,
    "path": "/healthz",
    "periodSeconds": 5,
    "port": 18081,
    "timeoutSeconds": 5,
    "type": "httpGet"
  },
  "replicas": 2,
  "resources": {
    "limits": {
      "cpu": "1",
      "memory": "1Gi"
    },
    "requests": {
      "cpu": "250m",
      "memory": "256Mi"
    }
  },
  "schemaVersion": 1,
  "serviceAccountName": "wm-coordinator",
  "serviceSpec": {
    "headless": false,
    "ports": [
      {
        "name": "http",
        "port": 18081,
        "targetPort": 18081
      }
    ]
  },
  "startupProbe": {
    "failureThreshold": 30,
    "path": "/healthz",
    "periodSeconds": 2,
    "port": 18081,
    "timeoutSeconds": 5,
    "type": "httpGet"
  },
  "terminationGracePeriodSeconds": 30,
  "tolerations": [],
  "topologySpreadConstraints": [
    {
      "labelSelector": {
        "matchLabels": {
          "loopit.me/service-id": "world-realtime-coordinator"
        }
      },
      "maxSkew": 1,
      "topologyKey": "topology.kubernetes.io/zone",
      "whenUnsatisfiable": "ScheduleAnyway"
    }
  ],
  "volumeMounts": [],
  "volumes": []
}

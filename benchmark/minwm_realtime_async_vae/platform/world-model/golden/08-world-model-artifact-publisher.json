{
  "activeDeadlineSeconds": 10800,
  "annotations": {
    "logs.loopit.me/enabled": "true"
  },
  "appGroup": "world-studio",
  "appName": "World Model Artifact Publisher",
  "args": [
    "--release",
    "/opt/sglang/benchmark/minwm_realtime_async_vae/model_releases/lingbot2/59cccf49f2d2dd27418ae7a04b82b10868d455c2/release-spec.template.json",
    "--offline-plan"
  ],
  "backoffLimit": 1,
  "businessLineId": "world-model",
  "clusterName": "world-model",
  "command": [
    "python3",
    "/opt/sglang/benchmark/minwm_realtime_async_vae/copy_model_release.py"
  ],
  "deployType": "job",
  "image": "${WORLD_MODEL_ARTIFACT_PUBLISHER_IMAGE_DIGEST}",
  "imagePullPolicy": "IfNotPresent",
  "kind": "task",
  "labels": {
    "app.kubernetes.io/part-of": "world-studio",
    "loopit.me/business-line": "world-model",
    "loopit.me/lane": "default",
    "loopit.me/managed-by": "platform",
    "loopit.me/service-id": "world-model-artifact-publisher"
  },
  "lane": "default",
  "name": "world-model-artifact-publisher",
  "namespace": "world-model",
  "networkPolicy": {
    "defaultDeny": true,
    "egressToServiceIds": [],
    "enabled": true,
    "externalEgress": [
      "s3.us-west-2.amazonaws.com",
      "s3.us-east-2.amazonaws.com"
    ],
    "ingressFromServiceIds": []
  },
  "nodeSelector": {},
  "requiredExecutionInputs": [
    "reviewed release spec generated by build_model_release_spec.py",
    "--execute",
    "--confirm-release-id=<reviewed release_id>"
  ],
  "resources": {
    "limits": {
      "cpu": "8",
      "ephemeral-storage": "32Gi",
      "memory": "16Gi"
    },
    "requests": {
      "cpu": "4",
      "ephemeral-storage": "16Gi",
      "memory": "8Gi"
    }
  },
  "schemaVersion": 1,
  "serviceAccountName": "wm-artifact-publisher",
  "tolerations": [],
  "volumeMounts": [],
  "volumes": []
}

ARG CPU_RUNTIME_IMAGE

FROM ${CPU_RUNTIME_IMAGE}
ARG SOURCE_REVISION

USER root
RUN python -m pip install --no-cache-dir prometheus-client==0.26.0

COPY python/sglang /opt/sglang/python/sglang
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      seedleap.minwm.image.layer="cpu-code-overlay"

USER 65532:65532
WORKDIR /opt/sglang/python/sglang/multimodal_gen/apps/realtime_webui

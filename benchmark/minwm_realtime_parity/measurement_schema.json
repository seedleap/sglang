{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seedleap/sglang/benchmark/minwm_realtime_parity/measurement_schema.json",
  "title": "MinWM realtime measurement",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "run_id",
    "timestamp_utc",
    "provenance",
    "workload",
    "measurement_contract",
    "metrics",
    "artifacts",
    "degradations"
  ],
  "properties": {
    "schema_version": {"const": "minwm-realtime-measurement/v1"},
    "mode": {"enum": ["profiler_off", "profiler_on"]},
    "run_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["sglang_commit", "minwm_commit", "container_image", "gpu"],
      "properties": {
        "sglang_commit": {"type": "string", "minLength": 1},
        "minwm_commit": {"$ref": "#/$defs/availability"},
        "container_image": {"$ref": "#/$defs/availability"},
        "gpu": {
          "type": "object",
          "required": ["model", "count"],
          "properties": {
            "model": {"$ref": "#/$defs/availability"},
            "count": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "model",
        "checkpoint",
        "resolution",
        "precision",
        "fast_lane",
        "sp_degree",
        "dmd_forwards_per_chunk",
        "clean_cache_forwards_per_chunk",
        "latent_frames_per_chunk",
        "pixel_frames_per_chunk",
        "warmup_chunks",
        "precondition_warmup_chunks",
        "measured_chunks"
      ],
      "properties": {
        "model": {"const": "MinWM 5B"},
        "precision": {"type": "string", "minLength": 1},
        "fast_lane": {"type": "boolean"},
        "sp_degree": {"type": "integer", "minimum": 1},
        "dmd_forwards_per_chunk": {"const": 4},
        "clean_cache_forwards_per_chunk": {"const": 1},
        "latent_frames_per_chunk": {"const": 4},
        "pixel_frames_per_chunk": {"const": 16},
        "warmup_chunks": {"type": "integer", "minimum": 1},
        "precondition_warmup_chunks": {"type": "integer", "minimum": 0},
        "measured_chunks": {"type": "integer", "minimum": 1}
      }
    },
    "measurement_contract": {
      "type": "object",
      "required": ["headline_eligible", "headline_rule", "timing_domains"]
    },
    "metrics": {"type": "object"},
    "artifacts": {"type": "object"},
    "degradations": {"type": "array"}
  },
  "$defs": {
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value", "unit", "source"],
          "properties": {"status": {"const": "available"}}
        },
        {
          "type": "object",
          "required": ["status", "reason", "evidence"],
          "properties": {"status": {"const": "unavailable"}}
        }
      ]
    }
  }
}
